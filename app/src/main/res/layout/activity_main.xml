<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtObjCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textDim"
            android:textSize="12sp"
            android:paddingRight="12dp" />

        <TextView
            android:id="@+id/txtMcpState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textDim"
            android:textSize="12sp" />
    </LinearLayout>

    <com.forge3d.studio.ViewportView
        android:id="@+id/viewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView
        android:id="@+id/selPanel"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:background="@color/panel"
        android:visibility="gone"
        android:fadeScrollbars="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/txtSelName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnDeleteSel"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_bg"
                    android:textColor="#FFFF5A5A"
                    android:textSize="11sp"
                    android:text="Eliminar"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Pos X (m)" android:textColor="@color/textDim" android:textSize="11sp" />
                <SeekBar android:id="@+id/sbPX" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="600" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Pos Y (m)" android:textColor="@color/textDim" android:textSize="11sp" />
                <SeekBar android:id="@+id/sbPY" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="600" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Pos Z (m)" android:textColor="@color/textDim" android:textSize="11sp" />
                <SeekBar android:id="@+id/sbPZ" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="600" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Rot X (°)" android:textColor="@color/textDim" android:textSize="11sp" />
                <SeekBar android:id="@+id/sbRX" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="360" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Rot Y (°)" android:textColor="@color/textDim" android:textSize="11sp" />
                <SeekBar android:id="@+id/sbRY" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="360" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Rot Z (°)" android:textColor="@color/textDim" android:textSize="11sp" />
                <SeekBar android:id="@+id/sbRZ" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="360" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Escala" android:textColor="@color/textDim" android:textSize="11sp" />
                <SeekBar android:id="@+id/sbScale" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="400" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Metálico" android:textColor="@color/textDim" android:textSize="11sp" />
                <SeekBar android:id="@+id/sbMetal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Rugosidad" android:textColor="@color/textDim" android:textSize="11sp" />
                <SeekBar android:id="@+id/sbRough" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">
                <Button android:id="@+id/colBtn1" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_margin="2dp" android:background="#FFF2F2F2" />
                <Button android:id="@+id/colBtn2" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_margin="2dp" android:background="#FF8C8C8C" />
                <Button android:id="@+id/colBtn3" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_margin="2dp" android:background="#FF1F1F1F" />
                <Button android:id="@+id/colBtn4" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_margin="2dp" android:background="#FFC0392B" />
                <Button android:id="@+id/colBtn5" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_margin="2dp" android:background="#FFE67E22" />
                <Button android:id="@+id/colBtn6" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_margin="2dp" android:background="#FFF1C40F" />
                <Button android:id="@+id/colBtn7" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_margin="2dp" android:background="#FF27AE60" />
                <Button android:id="@+id/colBtn8" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_margin="2dp" android:background="#FF2980B9" />
                <Button android:id="@+id/colBtn9" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_margin="2dp" android:background="#FF8E44AD" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <RadioGroup
        android:id="@+id/modeGroup"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp">

        <RadioButton
            android:id="@+id/modeOrbit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Órbita"
            android:textSize="12sp"
            android:textColor="@color/text"
            android:checked="true" />
        <RadioButton
            android:id="@+id/modeMove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mover"
            android:textSize="12sp"
            android:textColor="@color/text"
            android:paddingLeft="8dp" />
        <RadioButton
            android:id="@+id/modeRotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rotar"
            android:textSize="12sp"
            android:textColor="@color/text"
            android:paddingLeft="8dp" />
        <RadioButton
            android:id="@+id/modeScale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escalar"
            android:textSize="12sp"
            android:textColor="@color/text"
            android:paddingLeft="8dp" />
    </RadioGroup>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <Button android:id="@+id/btnCube" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_bg" android:textColor="@color/text" android:textSize="12sp" android:text="Cubo" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_margin="3dp" />
            <Button android:id="@+id/btnSphere" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_bg" android:textColor="@color/text" android:textSize="12sp" android:text="Esfera" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_margin="3dp" />
            <Button android:id="@+id/btnCylinder" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_bg" android:textColor="@color/text" android:textSize="12sp" android:text="Cilindro" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_margin="3dp" />
            <Button android:id="@+id/btnPlane" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_bg" android:textColor="@color/text" android:textSize="12sp" android:text="Plano" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_margin="3dp" />
            <Button android:id="@+id/btnImport" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_bg" android:textColor="@color/accent" android:textSize="12sp" android:text="Importar" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_margin="3dp" />
            <Button android:id="@+id/btnExportGlb" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_bg" android:textColor="@color/text" android:textSize="12sp" android:text="GLB" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_margin="3dp" />
            <Button android:id="@+id/btnExportGltf" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_bg" android:textColor="@color/text" android:textSize="12sp" android:text="glTF" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_margin="3dp" />
            <Button android:id="@+id/btnProjects" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_bg" android:textColor="@color/text" android:textSize="12sp" android:text="Proyecto" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_margin="3dp" />
            <Button android:id="@+id/btnMcp" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/btn_bg" android:textColor="@color/accent" android:textSize="12sp" android:text="MCP" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_margin="3dp" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
